# This config enforces all the network traffic to go through WireGuard tunnel, except local network traffic (192.168.100.0/24,127.0.0.0/8)
PostUp =  iptables -I ghaf-fw-dyn-filter-out ! -o %i ! -d 192.168.100.0/24 -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT; iptables -I ghaf-fw-dyn-filter-out -o %i -j ACCEPT
PreDown =  iptables -D ghaf-fw-dyn-filter-out ! -o %i ! -d 192.168.100.0/24 -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT; iptables -D ghaf-fw-dyn-filter-out -o %i -j ACCEPT

FwMark = 0xaa
