PostUp = iptables -I ghaf-fw-dyn-filter-fwd -i %i -j ACCEPT; iptables -t nat -A ghaf-fw-dyn-nat-post -o %bindIface -j MASQUERADE
PreDown = iptables -D ghaf-fw-dyn-filter-fwd -i %i -j ACCEPT; iptables -t nat -D ghaf-fw-dyn-nat-post -o %bindIface -j MASQUERADE
