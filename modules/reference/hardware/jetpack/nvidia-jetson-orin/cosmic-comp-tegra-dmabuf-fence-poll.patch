 };
+
+#[derive(Debug)]
+struct PollDmabufBlocker(std::sync::Arc<std::sync::atomic::AtomicBool>);
+
+impl Blocker for PollDmabufBlocker {
+    fn state(&self) -> BlockerState {
+        if self.0.load(std::sync::atomic::Ordering::SeqCst) {
+            BlockerState::Released
+        } else {
+            BlockerState::Pending
+        }
+    }
+}
+
+fn dmabuf_read_ready(dmabuf: &Dmabuf) -> bool {
+    dmabuf.handles().all(|handle| {
+        matches!(
+            rustix::event::poll(
+                &mut [rustix::event::PollFd::new(
+                    &handle,
+                    rustix::event::PollFlags::IN,
+                )],
+                Some(&rustix::time::Timespec {
+                    tv_sec: 0,
+                    tv_nsec: 0,
+                }),
+            ),
+            Ok(1)
+        )
+    })
+}
 use std::{collections::VecDeque, sync::Mutex, time::Duration};
@@ -214,2 +249,44 @@ impl CompositorHandler for State {
                 }
+
+                /*
+                 * Tegra's implicit-fence poll can transition to readable
+                 * without waking epoll. A timer-backed poll preserves the
+                 * blocker contract while ensuring calloop observes readiness
+                 * without requiring an unrelated input event.
+                 */
+                if std::env::var_os("COSMIC_POLL_DMABUF_FENCES").is_some()
+                    && !dmabuf_read_ready(&dmabuf)
+                {
+                    let signal =
+                        std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+                    let timer_signal = signal.clone();
+                    let timer_dmabuf = dmabuf.clone();
+                    let client = surface.client().unwrap();
+                    let timer = Timer::immediate();
+                    let res = state.common.event_loop_handle.insert_source(
+                        timer,
+                        move |_, _, state| {
+                            if dmabuf_read_ready(&timer_dmabuf) {
+                                timer_signal.store(true, std::sync::atomic::Ordering::SeqCst);
+                                let dh = state.common.display_handle.clone();
+                                state
+                                    .client_compositor_state(&client)
+                                    .blocker_cleared(state, &dh);
+                                TimeoutAction::Drop
+                            } else {
+                                TimeoutAction::ToDuration(Duration::from_millis(2))
+                            }
+                        },
+                    );
+
+                    if res.is_ok() {
+                        add_blocker(surface, PollDmabufBlocker(signal));
+                        return;
+                    }
+                }
+
+                /*
+                 * Default event-driven implicit-fence path. Keep it for
+                 * drivers whose DMA-BUF poll wakeup is reliable.
+                 */
                 if let Ok((blocker, source)) = dmabuf.generate_blocker(Interest::READ) {
