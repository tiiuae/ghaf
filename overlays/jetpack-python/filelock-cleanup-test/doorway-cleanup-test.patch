-    scans = 0
     cleanup_name: str | None = None
+    competitor_inserted = False
 
     def add_competitor_before_final_scan(path: int | str) -> Iterator[os.DirEntry[str]]:
-        nonlocal scans
-        scans += 1
-        if scans == 3:
-            Path(f"{lock_path}.filelock", "claims", competitor_name).write_text(
