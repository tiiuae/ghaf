From d15532115188040b656dda2a641a0872b7a286c8 Mon Sep 17 00:00:00 2001
From: Kajus Naujokaitis <kajusn@gmail.com>
Date: Fri, 23 Oct 2026 12:33:54 +0300
Subject: [PATCH] Support a BlueZ reached through a D-Bus proxy

- treat BlueZ as enabled and active once connected, as there is no
  local bluetooth.service to query
- power the adapter off over D-Bus when it has no rfkill device

Signed-off-by: Kajus Naujokaitis <kajusn@gmail.com>
---
 cosmic-settings/src/pages/bluetooth/mod.rs | 5 +++--
 subscriptions/bluetooth/src/adapter.rs     | 8 +++++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/cosmic-settings/src/pages/bluetooth/mod.rs b/cosmic-settings/src/pages/bluetooth/mod.rs
index 12bb73f..af8dd31 100644
--- a/cosmic-settings/src/pages/bluetooth/mod.rs
+++ b/cosmic-settings/src/pages/bluetooth/mod.rs
@@ -738,8 +738,9 @@ impl Page {
             }
 
             Message::DBusConnect(connection) => {
-                self.service_is_active = self.service_manager.is_active();
-                self.service_is_enabled = self.service_manager.is_enabled();
+                // BlueZ is reached through a D-Bus proxy, not a local bluetooth.service.
+                self.service_is_active = true;
+                self.service_is_enabled = true;
                 self.connection = Some(connection.clone());
 
                 let get_adapters_fut = get_adapters(connection.clone());
diff --git a/subscriptions/bluetooth/src/adapter.rs b/subscriptions/bluetooth/src/adapter.rs
index 756f893..271c01a 100644
--- a/subscriptions/bluetooth/src/adapter.rs
+++ b/subscriptions/bluetooth/src/adapter.rs
@@ -267,7 +267,13 @@ pub async fn change_adapter_status(
             return Event::Ok;
         }
     } else {
-        tracing::error!("Failed to find rfkill ID for bluetooth adapter {name:?}");
+        // No rfkill device for a proxied adapter, so power it off over D-Bus.
+        if !active {
+            return adapter
+                .set_powered(false)
+                .await
+                .map_or_else(Event::DBusError, |()| Event::Ok);
+        }
     }
 
     let mut result: zbus::Result<()> = Ok(());
-- 
