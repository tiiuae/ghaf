                     for (_output, surface_id) in self.common.surface_ids.iter() {
@@ -1106,6 +1154,7 @@ impl cosmic::Application for App {
                     self.value_tx_opt = None;
                     // Reset authenticating state
                     self.authenticating = false;
+                    self.restart_auth_pending = false;
                     // Try to create lockfile when locking
                     if let Some(ref lockfile) = self.flags.lockfile_opt
                         && let Err(err) = fs::File::create(lockfile)
@@ -1122,6 +1171,25 @@ impl cosmic::Application for App {
                     tracing::info!("session already locking or locked");
                 }
             },
+            Message::Resume => {
+                if matches!(self.state, State::Locked { .. }) {
+                    tracing::info!("scheduling authentication restart after resume");
+
+                    self.common.prompt_opt = None;
+                    self.common.error_opt = None;
+
+                    return cosmic::task::future(async {
+                        tokio::time::sleep(Duration::from_millis(2500)).await;
+                        Message::RestartAuth
+                    });
+                }
+            },
+            Message::RestartAuth => {
+                if matches!(self.state, State::Locked { .. }) {
+                    tracing::info!("forcing authentication restart after resume");
+                    return self.restart_auth_task();
+                }
+            },
             Message::Unlock => {
                 match self.state {
                     State::Locked { .. } => {
@@ -1133,6 +1201,7 @@ impl cosmic::Application for App {
