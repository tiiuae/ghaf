@@ -1010,6 +1057,7 @@ impl cosmic::Application for App {
                 SessionLockEvent::Unlocked => {
                     tracing::info!("session unlocked");
                     self.state = State::Unlocked;
+                    self.restart_auth_pending = false;
 
