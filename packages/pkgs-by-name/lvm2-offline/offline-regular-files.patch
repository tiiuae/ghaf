diff --git a/lib/id/id.c b/lib/id/id.c
--- a/lib/id/id.c
+++ b/lib/id/id.c
@@ -35,10 +35,25 @@ static char _inverse_c[256];
 
 int id_create(struct id *id)
 {
+	const char *seed = getenv("LVM_OFFLINE_UUID_SEED");
+	uint64_t state = UINT64_C(14695981039346656037);
 	unsigned i;
 	size_t len = sizeof(id->uuid);
 
 	memset(id->uuid, 0, len);
+	if (seed && *seed) {
+		for (; *seed; seed++) {
+			state ^= (unsigned char) *seed;
+			state *= UINT64_C(1099511628211);
+		}
+		for (i = 0; i < len; i++) {
+			state ^= i;
+			state *= UINT64_C(1099511628211);
+			id->uuid[i] = _c[state % (sizeof(_c) - 3)];
+		}
+		return 1;
+	}
+
 	if (!read_urandom(&id->uuid, len)) {
 		return 0;
 	}
