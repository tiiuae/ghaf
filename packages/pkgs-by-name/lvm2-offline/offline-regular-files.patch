--- a/lib/device/dev-cache.c
+++ b/lib/device/dev-cache.c
@@ -717,6 +717,16 @@ static int _insert_dev(const char *path, dev_t d)
 	struct device *dev;
 	struct device *dev_by_devt;
 	struct device *dev_by_path;
+	static dev_t loopfile_count = 0;
+	int loopfile = 0;
+
+	/* Use synthetic device numbers for explicitly configured regular files. */
+	if (!d) {
+		if (dev_cache_get_dev_by_name(path))
+			return 1;
+		d = ++loopfile_count;
+		loopfile = 1;
+	}
 
 	dev_by_devt = _dev_cache_get_dev_by_devno(_cache.devices, d);
 	dev_by_path = dev_cache_get_dev_by_name(path);
@@ -740,6 +750,8 @@ static int _insert_dev(const char *path, dev_t d)
 			/* create new device */
 			if (!(dev = _dev_create(d)))
 				return_0;
+		if (loopfile)
+			dev->flags |= DEV_REGULAR;
 
 		if (!(_dev_cache_insert_devno(_cache.devices, d, dev))) {
 			log_error("Couldn't insert device into binary tree.");
@@ -1199,6 +1211,9 @@ static int _insert_dirs(struct dm_list *dirs)
 
 void dev_cache_scan(struct cmd_context *cmd)
 {
+	struct dir_list *dl;
+	struct stat info;
+
 	log_debug_devs("Creating list of system devices.");
 
 	_cache.has_scanned = 1;
@@ -1207,6 +1222,11 @@ void dev_cache_scan(struct cmd_context *cmd)
 	_insert_dirs(&_cache.dirs);
 	setlocale(LC_COLLATE, "");
 
+	dm_list_iterate_items(dl, &_cache.files) {
+		if (!stat(dl->dir, &info) && S_ISREG(info.st_mode))
+			(void) _insert_dev(dl->dir, 0);
+	}
+
 	if (cmd->check_devs_used)
 		(void) _dev_cache_index_devs(cmd);
 }
@@ -1435,6 +1455,7 @@ int dev_cache_init(struct cmd_context *cmd)
 
 	_cache.dev_dir_len = strlen(_cache.dev_dir);
 	dm_list_init(&_cache.dirs);
+	dm_list_init(&_cache.files);
 
 	if (!_init_preferred_names(cmd))
 		goto_bad;
@@ -1562,6 +1583,33 @@ int dev_cache_add_dir(const char *path)
 	return 1;
 }
 
+int dev_cache_add_loopfile(const char *path)
+{
+	struct dir_list *dl;
+	struct stat st;
+	size_t len;
+
+	if (stat(path, &st)) {
+		log_warn("Ignoring %s: %s.", path, strerror(errno));
+		return 1;
+	}
+
+	if (!S_ISREG(st.st_mode)) {
+		log_warn("Ignoring %s: Not a regular file.", path);
+		return 1;
+	}
+
+	len = strlen(path);
+	if (!(dl = _zalloc(sizeof(*dl) + len + 1))) {
+		log_error("dir_list allocation failed for file");
+		return 0;
+	}
+
+	memcpy(dl->dir, path, len + 1);
+	dm_list_add(&_cache.files, &dl->list);
+	return 1;
+}
+
 struct device *dev_cache_get_dev_by_name(const char *name)
 {
 	return radix_tree_lookup_ptr(_cache.names, name, strlen(name));
